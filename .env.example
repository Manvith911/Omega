# Put secrets and machine-specific settings here.
# Committing this file with nothing in it is deliberate; the real .env is gitignored.
#
# A real run that uses an OpenAI model (when ollama is not available) needs a key.
# OPENAI_API_KEY=sk-...
#
# Other browsers already on this machine can be referenced from or to the omega
# installation, opening the application safely. The path is platform-specific.
# CHROME_EXECUTABLE="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
